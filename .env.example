# --- Local development (Vite) ---
# Set to true to disable HMR (less flicker during automated edits).
# DISABLE_HMR=true

# --- DICT eGovAI (https://egov-ai.e.gov.ph/developers) ---
# Issued to the LGU after its eGovAI agency access is approved. Server-side only:
# read by the dev/preview server and server/index.mjs, never bundled into the browser app.
# Leave blank to run the "Ask the Sanggunian" chat in demo mode (sample records).
# EGOVAI_API_KEY=
# EGOVAI_API_SECRET=
# EGOVAI_ENGINE_CODE=
