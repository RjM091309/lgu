# --- Local development (Vite) ---
# Set to true to disable HMR (less flicker during automated edits).
# DISABLE_HMR=true

# --- DICT eGovAI (https://egov-ai.e.gov.ph/developers) ---
# Issued to the LGU after its eGovAI agency access is approved. Server-side only:
# read by the dev/preview server and server/index.mjs, never bundled into the browser app.
# Leave blank to run the "Ask the Sanggunian" chat in demo mode (sample records).
# EGOVAI_API_KEY=
# EGOVAI_API_SECRET=
# EGOVAI_ENGINE_CODE=

# --- E-Session (live video sittings at /es) ---
# Camera and microphone need https, so the server also listens on this port (default 2511).
# Set to off to disable it.
# HTTPS_PORT=2511
# A trusted certificate (PEM files, e.g. from mkcert). Without them a self-signed one is generated.
# HTTPS_CERT=./certs/lims.pem
# HTTPS_KEY=./certs/lims-key.pem
# STUN/TURN servers for devices on different networks (not needed on one local network), as JSON:
# ESESSION_ICE_SERVERS=[{"urls":"stun:stun.example.org:3478"},{"urls":"turn:turn.example.org:3478","username":"lims","credential":"secret"}]
